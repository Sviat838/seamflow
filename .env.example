# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values may reach the browser.

# --- AI (server-only) ---
ANTHROPIC_API_KEY=
# Optional: override the classifier's default model (must support structured outputs).
CLASSIFIER_MODEL=
# Optional: override the Hot Dog Review Board (appeals) model.
REVIEW_MODEL=

# --- Supabase ---
# Public by design (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only sb_secret_... key (Project Settings > API Keys). Without it the app still
# classifies images but persists nothing (no history, sharing, or stats).
SUPABASE_SECRET_KEY=

# Google OAuth client. Configure it in Supabase (Auth > Providers > Google); not read by the app.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- App ---
# Random 32+ char string; HMAC key for hashing client IPs. `openssl rand -hex 32`
APP_SECRET=
# Bearer token for Vercel Cron calls to /api/cron/* (image retention purge). `openssl rand -hex 24`
CRON_SECRET=
# Abuse limits (defaults shown).
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100
GLOBAL_DAILY_SCAN_CAP=2000
